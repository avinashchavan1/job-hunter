{
  "name": "job-hunter",
  "version": "0.1.0",
  "description": "Finds and scores new jobs every morning; you click Apply.",
  "main": "./out/main/index.js",
  "author": "Avinash Chavan",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "web:dev": "vite --config web/vite.config.mts",
    "web:typecheck": "tsc --noEmit -p web/tsconfig.json",
    "web:build": "npm run web:typecheck && vite build --config web/vite.config.mts",
    "web:deploy": "npm run web:build && netlify deploy --prod --dir web/dist --site cba25219-5a91-46ed-bcef-43c80f031b18",
    "server:typecheck": "tsc -p server/tsconfig.json",
    "server:build": "npm run server:typecheck && node scripts/build-functions.mjs",
    "server:deploy": "npm run server:build && npx -y supabase@latest functions deploy jh-api --remote=vrhcofbhrcqthbacixpb --no-verify-jwt --use-api --workdir . --yes"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@supabase/supabase-js": "^2.119.2",
    "google-auth-library": "^11.3.4",
    "lucide-react": "^1.78.0",
    "mammoth": "^1.13.0",
    "playwright-core": "^1.65.1",
    "unpdf": "^2.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fflate": "^0.8.3",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "productName": "Job Hunter"
}
